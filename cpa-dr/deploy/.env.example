# Generate private .env and SSH identity with: bash scripts/setup.sh --data-dir TARGET
# TOKEN/TARGET are placeholders; do not use TOKEN as an administrator credential.
ADMIN_TOKEN=TOKEN
CPA_DATA_PATH=TARGET
STATE_PATH=./state-native
PORT=8787
SSH_PORT=2222
BIND_HOST=127.0.0.1
SSH_BIND_HOST=127.0.0.1
# rw supports confirmed restores; ro is backup-only.
DATA_ACCESS=rw
